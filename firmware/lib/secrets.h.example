#pragma once

// Copy this file to secrets.h and fill it in. secrets.h is gitignored.
// Same idea as the server's .env: credentials never go in source control.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// The cluster hostname only. No scheme, no port.
#define MQTT_HOST "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883

#define MQTT_USERNAME "your-broker-username"
#define MQTT_PASSWORD "your-broker-password"

// Must be unique on the broker. Use your own name in a shared class.
#define DEVICE_ID "esp32-01"
