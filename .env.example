# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real credentials.

# --- MQTT broker ---------------------------------------------------------
# HiveMQ Cloud gives you a URL like:
#   xxxxxxxxxxxx.s1.eu.hivemq.cloud
# Use the mqtts:// scheme and port 8883 for the TLS listener.
MQTT_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-broker-username
MQTT_PASSWORD=your-broker-password

# Optional. A client id must be unique per connection on the broker.
# Leave it blank and the server generates a random one for you.
MQTT_CLIENT_ID=

# Optional. The root of every topic this project uses.
MQTT_BASE_TOPIC=spectral/esp32

# --- Mock device (scripts/mock-device.ts) --------------------------------
# The device id the mock publishes as. Use your own name so you do not
# collide with a classmate on a shared broker.
MOCK_DEVICE_ID=esp32-01

# --- HTTP API ------------------------------------------------------------
# Port this server listens on.
HTTP_PORT=3000

# 0.0.0.0 accepts connections from other machines on your network.
# Use 127.0.0.1 to accept only from this machine.
HTTP_HOST=0.0.0.0

# The exact origin of your dashboard. Scheme, host, and port must all match.
CORS_ORIGIN=http://localhost:3001

# --- Database ------------------------------------------------------------
# Local Postgres, the path used in class:
DATABASE_URL="postgresql://iot:iot@localhost:5432/iot"
# A hosted database works identically. Only this line changes.

# --- AI agent (optional) -------------------------------------------------
# Any OpenAI-compatible provider works. Leave LLM_API_KEY blank and the
# server still runs; only /api/agent/ask is disabled.
#
#   Groq      https://api.groq.com/openai/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral   https://api.mistral.ai/v1
#   Ollama    http://localhost:11434/v1     (local, no key needed)
#
# Note: Groq and Grok are different companies. Groq (groq.com) runs open
# models and has a free tier. Grok is xAI's model and is paid.
#
# Free tiers, rate limits and model names change often, sometimes without
# notice. Check the provider's own docs, then confirm tool calling works:
#
#   npm run verify:llm
#
# Each student needs their own key. One agent question costs 2 to 4 requests,
# so a shared key hits per-minute limits within the first minute of a lesson.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Hard cap on tool-calling rounds per question.
AGENT_MAX_STEPS=8
