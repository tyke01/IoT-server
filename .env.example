
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real credentials.

# --- MQTT broker ---------------------------------------------------------
# HiveMQ Cloud gives you a URL like:
#   xxxxxxxxxxxx.s1.eu.hivemq.cloud
# Use the mqtts:// scheme and port 8883 for the TLS listener.
MQTT_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-broker-username
MQTT_PASSWORD=your-broker-password

# Optional. A client id must be unique per connection on the broker.
# Leave it blank and the server generates a random one for you.
MQTT_CLIENT_ID=

# Optional. The root of every topic this project uses.
MQTT_BASE_TOPIC=spectral/esp32

# --- Mock device (scripts/mock-device.ts) --------------------------------
# The device id the mock publishes as. Use your own name so you do not
# collide with a classmate on a shared broker.
MOCK_DEVICE_ID=esp32-01

# --- HTTP API ------------------------------------------------------------
# Port this server listens on.
HTTP_PORT=3000

# 0.0.0.0 accepts connections from other machines on your network.
# Use 127.0.0.1 to accept only from this machine.
HTTP_HOST=0.0.0.0

# The exact origin of your dashboard. Scheme, host, and port must all match.
CORS_ORIGIN=http://localhost:3001

# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
